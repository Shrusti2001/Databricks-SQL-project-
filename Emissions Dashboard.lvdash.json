{
  "datasets": [
    {
      "name": "196eee36",
      "displayName": "Location Data",
      "queryLines": [
        "Select  latitude, \r\n",
        "longitude , \r\n",
        "`GHG emissions mtons CO2e` as Emissions \r\n",
        "from emissions.default.emissions_data"
      ]
    },
    {
      "name": "cee99119",
      "displayName": "Emissions per person",
      "queryLines": [
        "Select\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  (\r\n",
        "    CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS BIGINT) / population\r\n",
        "  ) as Emissions_per_person\r\n",
        "from\r\n",
        "  emissions.default.emissions_data\r\n",
        "order by\r\n",
        "  emissions_per_person desc"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "eca187d0",
      "displayName": "Total emissions per state",
      "queryLines": [
        "Select state_abbr, \r\n",
        "       (SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS BIGINT)) / SUM(population)) as Total_emissions\r\n",
        "from emissions_data\r\n",
        "Group by state_abbr\r\n",
        "order by Total_emissions desc\r\n",
        "limit 10\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "216685b6",
      "displayName": "County Shaming",
      "queryLines": [
        "Select county_state_name, \r\n",
        "       population, \r\n",
        "       CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS double) AS Total_emissions\r\n",
        "from emissions_data\r\n",
        "order by Total_emissions desc\r\n",
        "limit 10\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
